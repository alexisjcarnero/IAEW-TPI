# Puerto de la API
PORT=3000

# Base de datos (PostgreSQL)
POSTGRES_DB=iaew_mesa_ayuda
POSTGRES_USER=iaew
POSTGRES_PASSWORD=colocar-password-local
DATABASE_URL=postgresql://iaew:colocar-password-local@db:5432/iaew_mesa_ayuda?schema=public

# Auth0 (OAuth 2.0 / JWT)
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://iaew-mesa-ayuda-api

# API Key para el endpoint interno de ejemplo (x-api-key)
INTERNAL_API_KEY=colocar-api-key-local

# RabbitMQ
RABBIT_USER=iaew
RABBIT_PASS=iaew-local
RABBIT_URL=amqp://iaew:iaew-local@rabbitmq:5672
RABBIT_EXCHANGE=mesa-ayuda.eventos

# Webhook saliente (integración adicional)
WEBHOOK_URL=http://webhook-receiver:4000/webhooks/mesa-ayuda
WEBHOOK_SECRET=colocar-secreto-compartido-local

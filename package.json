{
  "name": "iaew-2026-mesa-ayuda",
  "version": "1.0.2",
  "description": "Sistema de Mesa de ayuda para el TPI de IAEW 2026: API REST, RabbitMQ, worker, webhook y observabilidad.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "test:unit": "node --test test/unit/*.test.js",
    "validate:artifacts": "node scripts/validate-artifacts.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-oauth2-jwt-bearer": "1.10.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "prisma": "^5.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "3.1.11",
    "yaml": "^2.8.1"
  }
}
